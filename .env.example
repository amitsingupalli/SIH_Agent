# =====================================================================
# MahaArogya-Agent Environment Configuration Template (.env.example)
# SIH 2026 PS 133 | Govt of Maharashtra Health Department
#
# IMPORTANT:
# - Copy this file to '.env' for local development: `cp .env.example .env`
# - NEVER commit your real '.env' file or personal credentials to Git!
# - All keys in this file are dummy placeholders.
# =====================================================================

# 1. System Settings
PROJECT_NAME="MahaArogya-Agent"
DEFAULT_STATE="Maharashtra"
DEFAULT_LANGUAGE="mr"
REFERRAL_SLA_HOURS=48
CRITICAL_RUNWAY_DAYS_THRESHOLD=7

# 2. Vernacular Voice & STT Services (Bhashini / Whisper)
BHASHINI_API_KEY="your_bhashini_api_key_here"
BHASHINI_USER_ID="gov_maha_health_dept"
BHASHINI_PIPELINE_ID="asr_translation_tts_pipeline"

# 3. Persistence & Database (SQLite / PostgreSQL / Redis)
DATABASE_URL="sqlite+aiosqlite:///./maha_arogya.db"
REDIS_URL="redis://localhost:6379/0"

# 4. Cryptographic Security & QR Referral HMAC Signing Secret
# (Generate a strong random secret for production deployments)
QR_SIGNING_SECRET="change-this-to-a-secure-random-production-secret-key"

# 5. Role-Based Access Control API Keys (Demonstration Defaults)
ROLE_API_KEY_ASHA="maha-asha-2026"
ROLE_API_KEY_DOCTOR="maha-doctor-2026"
ROLE_API_KEY_DHO="maha-dho-2026"
ROLE_API_KEY_ADMIN="maha-admin-2026"
